{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Notifications": {
    "DefaultHistorySize": 20,
    "MaxHistorySize": 100,
    "SubscriberBufferSize": 100
  }
}
